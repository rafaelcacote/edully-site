APP_NAME=Edully
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://agendaedully.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=error

# Domínio do site (só o host). Vazio = responde em qualquer host (recomendado atrás do Nginx).
EDULLY_SITE_DOMAIN=
EDULLY_APP_DOMAIN=app.agendaedully.com.br
EDULLY_CONTACT_EMAIL=comercial@agendaedully.com.br
EDULLY_LOGIN_URL=https://app.agendaedully.com.br/login

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=edully_site
DB_USERNAME=edully
DB_PASSWORD=troque-esta-senha-site

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@agendaedully.com.br"
MAIL_FROM_NAME="${APP_NAME}"

RUN_MIGRATIONS=true
