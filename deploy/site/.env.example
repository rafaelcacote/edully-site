APP_NAME=Edully
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://agendaedully.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=error

# Domínio do site (só o host). Vazio = responde em qualquer host (recomendado atrás do Nginx).
EDULLY_SITE_DOMAIN=
EDULLY_APP_DOMAIN=app.agendaedully.com.br
EDULLY_CONTACT_EMAIL=contato@agendaedully.com.br
EDULLY_CONTACT_WHATSAPP=5591999999999
EDULLY_CONTACT_INSTAGRAM=https://www.instagram.com/agendaedully/
EDULLY_LEAD_NOTIFY_EMAIL=contato@agendaedully.com.br
EDULLY_LOGIN_URL=https://app.agendaedully.com.br/login

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=edully_site
DB_USERNAME=edully
DB_PASSWORD=troque-esta-senha-site

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contato@agendaedully.com.br
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@agendaedully.com.br"
MAIL_FROM_NAME="Edully"

RUN_MIGRATIONS=true
